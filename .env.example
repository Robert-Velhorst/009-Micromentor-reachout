# Optional encryption at rest. Use a long unique value and keep the real .env out of Git.
MARO_LEDGER_PASSPHRASE=

# Keep outbound handoffs paused regardless of the workspace setting.
MARO_OUTBOUND_PAUSED=0

# Enable the read-only HAI generic_json_feed connector.
MARO_HAI_FEED_ENABLED=0

# Required for the normal protected ngrok flow, for example operator:long-password.
NGROK_BASIC_AUTH=

# Explicitly unsafe without another access layer. Prefer NGROK_BASIC_AUTH.
MARO_ALLOW_PUBLIC_TUNNEL=0
