{
  "name": "mentor-messenger-landing",
  "version": "1.2.3",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "npm run tunnel",
    "build": "node scripts/build.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "installer:win": "npm run build && node scripts/build-windows-installer.mjs",
    "start": "node dist/index.cjs",
    "tunnel": "npm run build && node scripts/ngrok.mjs",
    "preview": "npm run tunnel",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "check:api": "npm run build && node scripts/check-ledger-api.mjs",
    "check:extension": "node scripts/check-manual-handoff-extension.mjs",
    "check:operational": "npm run build && node scripts/check-operational.mjs",
    "check:recommendations": "node scripts/check-recommendations.mjs",
    "check:mentor-pagination": "node scripts/check-mentor-pagination.mjs",
    "check:localization": "node scripts/check-localization.mjs",
    "check:storage": "npm run build && node scripts/check-storage-failures.mjs",
    "check:client-requests": "node scripts/check-client-requests.mjs",
    "check:ngrok": "npm run build && node scripts/check-ngrok-launcher.mjs",
    "check:windows-ngrok": "npm run installer:win && node scripts/check-windows-ngrok.mjs",
    "test": "npm run check:api && npm run check:extension && npm run check:recommendations && npm run check:mentor-pagination && npm run check:localization && npm run check:client-requests && node scripts/check-storage-failures.mjs && node scripts/check-ngrok-launcher.mjs",
    "doctor": "node scripts/doctor.mjs",
    "audit:security": "npm audit --audit-level=low",
    "check:release": "node scripts/check-release.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "express": "^4.19.2",
    "lucide-react": "^0.417.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.4.0",
    "wouter": "^3.3.1"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.28.1",
    "prettier": "^3.3.3",
    "tailwindcss": "4.1.18",
    "typescript": "^5.5.3",
    "vite": "^6.4.3"
  }
}
