{
  "name": "mentor-messenger-landing",
  "version": "1.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "npm run dev:vite",
    "dev:vite": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "installer:win": "npm run build && node scripts/build-windows-installer.mjs",
    "start": "node dist/index.cjs",
    "tunnel": "npm run build && node scripts/ngrok.mjs",
    "preview": "npm run build && npm run start",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "check:api": "npm run build && node scripts/check-ledger-api.mjs",
    "check:release": "node scripts/check-release.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "express": "^4.19.2",
    "lucide-react": "^0.417.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "2.2.0",
    "tslib": "2.8.1",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "^0.28.2",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.3",
    "vite": "^8.3.4"
  }
}
