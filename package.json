{
  "name": "mentor-messenger-landing",
  "version": "1.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "npm run tunnel",
    "dev:vite": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "installer:win": "npm run build && node scripts/build-windows-installer.mjs",
    "start": "node dist/index.cjs",
    "tunnel": "npm run build && node scripts/ngrok.mjs",
    "preview": "npm run tunnel",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "check:api": "npm run build && node scripts/check-ledger-api.mjs",
    "check:release": "node scripts/check-release.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "express": "5.3.0",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "wouter": "3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
